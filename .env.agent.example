# ColdVault AGENT settings — for a second machine next to the master.
# Copy to .env on that machine and use docker-compose.agent.yml.
# The bucket, key prefix, storage class, canary file name, duplicate and
# manifest checks all come from the master; only what is specific to this
# machine goes here.

# --- Role ---
COLDVAULT_ROLE=agent
# How this machine is shown in the master's UI ("Upload from", "Download to").
COLDVAULT_NAME=pi

# --- The master ---
# Use the master's LAN IP if its name doesn't resolve inside Docker
# (e.g. http://<master-LAN-IP>:9999).
COLDVAULT_MASTER_URL=http://master-host:9999
# The same long random value as COLDVAULT_AGENT_TOKEN on the master.
COLDVAULT_AGENT_TOKEN=

# --- AWS credentials for THIS machine ---
# Ideally a separate IAM user that can upload and download but NOT delete —
# see README "Second machine (agent)" for the policy.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=eu-central-1

# --- Drives and folders on this machine ---
COLDVAULT_WATCH_DIRS=/media
COLDVAULT_WATCH_INTERVAL=10
# Extra roots allowed for manual uploads (comma-separated). Each must also be
# bind-mounted in docker-compose.agent.yml.
COLDVAULT_BROWSE_ROOTS=
COLDVAULT_DOWNLOAD_DIR=/downloads
# Flag a canary drive as ready to unmount after a clean upload (needs the
# deploy/usb-automount eject helper on this machine).
COLDVAULT_EJECT_AFTER_UPLOAD=false

# --- Performance (this machine's own hardware) ---
# A Raspberry Pi has little RAM and an SD card: smaller parts, fewer workers.
# Temp disk needed in data/tmp: PART_SIZE_MB x PART_WORKERS x UPLOAD_WORKERS.
COLDVAULT_UPLOAD_WORKERS=1
# Files up to this size upload straight from the drive, with nothing written to
# this machine's disk; only bigger files are staged in parts in data/tmp. 4096
# keeps writes off an SD card for most files (one stream tops out ~20-40 MB/s,
# usually above the internet upload anyway). Keep it under 5120: S3 refuses a
# single upload over 5 GB.
COLDVAULT_MULTIPART_THRESHOLD_MB=4096
COLDVAULT_PART_SIZE_MB=128
COLDVAULT_PART_WORKERS=4
COLDVAULT_DOWNLOAD_WORKERS=1
COLDVAULT_DOWNLOAD_PART_WORKERS=4
COLDVAULT_DOWNLOAD_PART_SIZE_MB=128

# --- App ---
COLDVAULT_PORT=9999
TZ=
